/** Measuring what OpenStreetMap cannot see.
  *
  * Two territories whose underground is far larger than their surface, and
  * which differ in the way that decides what a measurement can say.
  *
  * GIBRALTAR has roughly 55 km of tunnels inside a 6.7 km² rock, cut between
  * 1782 and 1967, almost all military and sealed. The true length is PUBLISHED,
  * so the omission can be measured rather than guessed at: OSM holds 12%.
  *
  * JERSEY has no such figure. The German occupation drove tunnel complexes into
  * the island with forced labour from 1941, and destroyed the records before the
  * May 1945 surrender — so not even the NUMBER of complexes is known (19-25 were
  * planned). There is no denominator, and inventing one would be the only way to
  * produce a percentage.
  *
  * That is why `mapped_pct` is not a return of `Survey`. A field that cannot
  * exist for some inputs has no business in a signature that promises it for
  * all of them; the caller gets `has_denominator` and the full `stats`, and
  * `summary` states in words what this place supports. Sources for every
  * published figure: docs/sources.md.
  *
  * Both surveys read a small extract from the local planet split — no Overpass,
  * no rate limit, no network at measurement time.
  */
namespace gibraltar {

    /** Measure one place's mapped network, its mapped tunnels, and the surface
      * evidence of the rest (cave entrances, bunkers, batteries).
      *
      * `place` selects the published ground truth to compare against, and with
      * `pbf` empty also resolves the extract from FW_OSM_LOCAL_EXTRACTS.
      * Returns the geometry as well as the statistics, so the render step needs
      * no second pass over the extract. */
    event facet Survey(
        place: String = "gibraltar",
        pbf: String = "",
        out_dir: String = "gibraltar-out"
    ) => (
        stats_path: String,
        place_name: String,
        tunnel_km: Double,
        tunnel_km_distinct: Double,
        has_denominator: Boolean,
        summary: String,
        feature_count: Int,
        stats: Json,
        features: Json
    ) with Effect(kind = "io") with Cost(tier = "cheap")

    /** Draw it: a self-contained page — inline SVG, no CDN, no tile server.
      *
      * Deliberate. The subject is an ABSENCE; a page that needed a basemap to be
      * legible would be leaning on someone else's data at the exact moment it
      * claims a gap. The page adapts to whether the place has a denominator. */
    event facet RenderMap(
        stats: Json,
        features: Json,
        out_dir: String = "gibraltar-out",
        title: String = ""
    ) => (
        map_path: String,
        feature_count: Int
    ) with Effect(kind = "io") with Cost(tier = "cheap")

    /** Survey one place, then draw it. */
    workflow TunnelSurvey(
        place: String = "gibraltar",
        pbf: String = "",
        out_dir: String = "gibraltar-out",
        title: String = ""
    ) => (
        map_path: String,
        stats_path: String,
        place_name: String,
        summary: String
    ) andThen {
        surveyed = Survey(place = $.place, pbf = $.pbf, out_dir = $.out_dir)

        drawn = RenderMap(
            stats = surveyed.stats,
            features = surveyed.features,
            out_dir = $.out_dir,
            title = $.title
        )

        yield TunnelSurvey(
            map_path = drawn.map_path,
            stats_path = surveyed.stats_path,
            place_name = surveyed.place_name,
            summary = surveyed.summary
        )
    }

    /** Gibraltar: the case WITH a published denominator. */
    workflow HollowMountain(
        pbf: String = "",
        out_dir: String = "gibraltar-out"
    ) => (
        map_path: String,
        stats_path: String,
        summary: String
    ) andThen {
        run = TunnelSurvey(place = "gibraltar", pbf = $.pbf, out_dir = $.out_dir)

        yield HollowMountain(
            map_path = run.map_path,
            stats_path = run.stats_path,
            summary = run.summary
        )
    }

    /** Jersey: the case WITHOUT one — where the size of the gap is itself
      * unrecoverable, because the records were destroyed in 1945. */
    workflow OccupiedIsland(
        pbf: String = "",
        out_dir: String = "jersey-out"
    ) => (
        map_path: String,
        stats_path: String,
        summary: String
    ) andThen {
        run = TunnelSurvey(place = "jersey", pbf = $.pbf, out_dir = $.out_dir)

        yield OccupiedIsland(
            map_path = run.map_path,
            stats_path = run.stats_path,
            summary = run.summary
        )
    }
}
